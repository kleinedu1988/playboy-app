  {
   "nazev": "zavrit-dv",
   "js": "(()=>{const h=[...document.querySelectorAll('*')].find(e=>e.offsetParent&&e.children.length===0&&e.textContent.trim()==='Dnešní výběr');let p=h;for(let i=0;i<5&&p;i++){p=p.parentElement;const b=p&&[...p.querySelectorAll('button')].find(b=>/^[×✕]?$/.test(b.textContent.trim())&&b.offsetParent);if(b){b.click();return 'zavřeno'}}return 'nenalezeno'})()",
   "cekat": 800
  },
  {
   "nazev": "g-nabidka",
   "js": "(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.getClientRects().length&&b.getBoundingClientRect().top<70&&b.textContent.trim()==='⋯'||b.getAttribute('aria-label')==='Další akce');if(!b)return 'bez ⋯: '+[...document.querySelectorAll('button')].filter(b=>b.getBoundingClientRect().top<70).map(b=>b.getAttribute('aria-label')||b.title||b.textContent.trim()).join('/');b.click();return 'ok'})()",
