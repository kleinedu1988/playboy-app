   "cekat": 1000
  },
  {
   "nazev": "po2s",
   "js": "(()=>{const o=document.querySelector('.pdf-okno');const ozn=[...document.querySelectorAll('.oznameni, [role=status], .toast, [aria-live]')].map(e=>e.textContent.trim()).filter(t=>/PDF|stran|Otevírám/.test(t)).slice(-3);const zdroje=performance.getEntriesByType('resource').filter(e=>/pdf/.test(e.name)).map(e=>e.name.split('/').pop().slice(0,40)+' '+Math.round(e.duration)+'ms '+Math.round((e.transferSize||e.encodedBodySize||0)/1024)+'kB');const platna=o?[...o.querySelectorAll('.pdf-platno')].map(c=>c.width+'x'+c.height):[];const nahledy=o?[...o.querySelectorAll('.pdf-nahled canvas')].filter(c=>c.width!==300).length:0;return JSON.stringify({okno:o&&!o.classList.contains('hidden'),ozn,zdroje,platna,nahledy})})()",
