  {
   "nazev": "zavrit",
   "js": "(()=>{const tl=t=>[...document.querySelectorAll('button')].find(b=>b.offsetParent&&b.textContent.trim()===t);tl('Později')?.click();document.querySelectorAll('.dnesni-vyber button[aria-label], [class*=dnesni] .zavrit, [aria-label=\"Zavřít\"]').forEach(b=>b.offsetParent&&b.click());document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape'}));return 'ok'})()",
   "cekat": 1500
  },
  {
   "nazev": "zavrit-dv",
   "js": "(()=>{const h=[...document.querySelectorAll('*')].find(e=>e.offsetParent&&e.children.length===0&&e.textContent.trim()==='Dnešní výběr');let p=h;for(let i=0;i<5&&p;i++){p=p.parentElement;const b=p&&[...p.querySelectorAll('button')].find(b=>/^[×✕]?$/.test(b.textContent.trim())&&b.offsetParent);if(b){b.click();return 'zavřeno'}}return 'nenalezeno'})()",
   "cekat": 800
  },
  {
   "nazev": "s-pb",
   "js": "(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.getClientRects().length&&b.getBoundingClientRect().top<70&&(b.textContent.trim()==='Statistiky'||b.title?.startsWith('Statistiky')||b.getAttribute('aria-label')==='Statistiky'));if(!b)return 'bez: '+[...document.querySelectorAll('button')].filter(b=>b.getBoundingClientRect().top<70).map(b=>b.title||b.textContent.trim()).join('/');b.click();return 'ok'})()",
   "cekat": 5000
  },
  {
   "nazev": "m-mapa",
   "js": "(()=>{const b=document.querySelector('[data-sp-graf-volba=\"mapa\"]');if(!b)return 'bez';b.click();return 'ok'})()",
   "cekat": 8000
  },
  {
   "nazev": "m-casopis",
   "js": "(()=>{const b=document.querySelector('[data-sp-mapa-barva=\"casopis\"]');if(!b)return 'bez volby';b.click();return 'ok'})()",
   "cekat": 3000
  },
  {
   "nazev": "m-penthouse",
   "js": "(()=>{const b=document.querySelector('[data-sp-mapa-kategorie=\"Penthouse\"]');if(!b)return 'bez legendy';b.click();return document.querySelector('[data-sp-legenda]').innerText.replace(/\\n+/g,' | ')+' || '+document.querySelector('[data-sp-seznam]').innerText.replace(/\\n+/g,' | ').slice(0,200)})()",
   "cekat": 2500
  }
